    "katex": "^0.16.11",
    "mammoth": "^1.12.0",
    "marked": "^12.0.2",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
