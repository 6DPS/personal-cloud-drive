# Ensure Windows batch, PowerShell, and VBScript files use CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Ensure macOS and Linux shell scripts use Unix LF
*.sh text eol=lf
*.command text eol=lf

# Exclude non-runtime documentation and heavy screenshot files from GitHub Release & OTA zip archives
docs/ export-ignore
*.pdf export-ignore
packaging/ export-ignore
backups/ export-ignore
