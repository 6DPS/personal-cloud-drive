# ===================================================
# DPSir 个人网盘环境配置文件示例 (.env.example)
# ===================================================

# 1. 网盘文件与用户数据存储根目录
# 支持任意盘符或挂载路径，例如:
# STORAGE_BASE_ROOT=D:\PersonalCloudDrive
# STORAGE_BASE_ROOT=E:\PersonalCloudDrive
# STORAGE_BASE_ROOT=F:\Data\PersonalCloudDrive
STORAGE_BASE_ROOT=D:\PersonalCloudDrive

# 2. 网盘服务监听端口与地址
PORT=8081
HOST=0.0.0.0

# 3. 管理员用户名（默认 admin）
CLOUD_DRIVE_USER=admin

# 4. 管理员登录密码（可在此设置强密码）
# CLOUD_DRIVE_PASSWORD=your_secure_password_here

# 5. 公网访问域名（选填，若配置了 Cloudflare 等公网穿透）
PUBLIC_ACCESS_URL=https://pan.yourdomain.com
