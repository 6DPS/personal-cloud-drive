# ===================================================
# DPSir 个人网盘环境配置文件示例 (.env.example)
# ===================================================

# 1. 网盘文件与用户数据存储根目录
# 支持任意盘符或挂载路径，例如:
# STORAGE_BASE_ROOT=D:\PersonalCloudDrive
# STORAGE_BASE_ROOT=E:\PersonalCloudDrive
# STORAGE_BASE_ROOT=F:\Data\PersonalCloudDrive
STORAGE_BASE_ROOT=D:\PersonalCloudDrive

# 2. 网盘服务监听端口与地址
PORT=8081
HOST=0.0.0.0

# 3. 管理员用户名（默认 admin）
CLOUD_DRIVE_USER=admin

# 4. 管理员登录密码与物理兜底恢复密码（首次部署作为初始密码）
# 💡 贴心设计：若日后不小心忘记管理员密码，只需在此处填入新密码并重启网盘，
# 即可直接在网页登录框用该新密码一键登录（系统会自动同步数据库），无需点击找回密码！
# CLOUD_DRIVE_PASSWORD=your_secure_password_here

# 5. DeepSeek AI 引擎 API Key（启用 AI 全库问答与文档智能总结功能）
# 可前往 DeepSeek 开放平台 (https://platform.deepseek.com/) 申请
# 支持 DEEPSEEK_API_KEY 或 YUNPAN_DEEPSEEK_KEY 两种名称：
# DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
# YUNPAN_DEEPSEEK_KEY=sk-your_deepseek_api_key_here

# 6. 公网访问域名（选填，若配置了 Cloudflare 等公网穿透）
PUBLIC_ACCESS_URL=https://pan.yourdomain.com

# 7. 子账号默认存储空间配额（单位 GB，默认 20GB，管理员在后台可随时对任意用户动态扩容或设为无限制）
# DEFAULT_USER_QUOTA_GB=20

